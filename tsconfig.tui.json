{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./tui/dist",
    "rootDir": "./tui/src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["tui/src/**/*.ts"]
}
