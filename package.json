{
  "name": "git-shortcut-tui",
  "version": "0.1.7",
  "description": "A hobbyist Git helper that reduces friction while keeping you in control",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anlaki-py/g.git"
  },
  "homepage": "https://github.com/anlaki-py/g#readme",
  "keywords": [
    "git",
    "cli",
    "tui",
    "shortcut"
  ],
  "type": "module",
  "bin": {
    "g": "dist/g.js"
  },
  "scripts": {
    "build": "esbuild tui/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=tui/dist/index.js && tsc -p tsconfig.tui.json && esbuild bin/g.ts --bundle --platform=node --format=esm --packages=external --external:../tui/dist/index.js --outfile=dist/g.js",
    "check": "tsc --noEmit && eslint .",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "start": "node bin/g.ts"
  },
  "files": [
    "dist",
    "tui/dist",
    "tui/native"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
