{
  "name": "git-shortcut-tui",
  "version": "0.1.0",
  "description": "A hobbyist Git helper that reduces friction while keeping you in control",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anlaki-py/g.git"
  },
  "homepage": "https://github.com/anlaki-py/g#readme",
  "keywords": [
    "git",
    "cli",
    "tui",
    "shortcut"
  ],
  "type": "module",
  "bin": {
    "g": "bin/g.js"
  },
  "scripts": {
    "build": "esbuild tui/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=tui/dist/index.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "start": "node bin/g.js"
  },
  "files": [
    "bin",
    "src",
    "tui/dist",
    "tui/native"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
